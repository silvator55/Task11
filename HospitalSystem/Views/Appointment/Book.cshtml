@model HospitalSystem.Models.Appointment

@{
    ViewData["Title"] = "Book Appointment";
}

<style>
    
    body {
        background: linear-gradient(135deg, #e0f2fe 0%, #cbd5e1 100%);
        min-height: 100vh;
    }

    
    .booking-card {
        background: #ffffff;
        border: none;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(15, 23, 42, 0.12);
        overflow: hidden;
    }

    .booking-header {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
    }

    
    .form-control:focus, .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card booking-card">
               
                <div class="booking-header text-white text-center py-4 px-3">
                    <h3 class="mb-0 fw-bold">Book Appointment</h3>
                    <p class="mb-0 text-white-50 small mt-1">Fill in the details below to confirm your visit</p>
                </div>

                <div class="card-body p-4 p-md-5">

                    
                    @if (Model.Doctor != null)
                    {
                        <div class="d-flex align-items-center mb-4 p-3 bg-light rounded-4 border">
                            <img src="@Model.Doctor.Image" alt="@Model.Doctor.Name" class="rounded-circle me-3 shadow-sm" style="width: 60px; height: 60px; object-fit: cover;">
                            <div>
                                <h5 class="mb-1 text-primary fw-bold">@Model.Doctor.Name</h5>
                                <span class="badge bg-info text-dark rounded-pill px-3 py-2">@Model.Doctor.Specialization</span>
                            </div>
                        </div>
                    }

                    <form asp-action="Book" method="post">
                        <input type="hidden" asp-for="DoctorId" />

                       
                        <div class="mb-3">
                            <label asp-for="PatientName" class="form-label fw-semibold text-secondary">Patient Name</label>
                            <input asp-for="PatientName" class="form-control form-control-lg rounded-3" placeholder="Enter patient name" />
                            <span asp-validation-for="PatientName" class="text-danger small"></span>
                        </div>

                        
                        <div class="mb-3">
                            <label asp-for="Date" class="form-label fw-semibold text-secondary">Date</label>
                            <input asp-for="Date" class="form-control form-control-lg rounded-3" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="Date" class="text-danger small"></span>
                        </div>

                        
                        <div class="mb-4">
                            <label asp-for="Time" class="form-label fw-semibold text-secondary">Appointment Time (Working Hours: 09:00 AM - 04:30 PM)</label>
                            <select asp-for="Time" class="form-select form-select-lg rounded-3">
                                @{
                                    TimeSpan start = new TimeSpan(9, 0, 0);   
                                    TimeSpan end = new TimeSpan(16, 30, 0);   

                                    while (start <= end)
                                    {
                                        string displayTime = DateTime.Today.Add(start).ToString("hh:mm tt");
                                        string timeValue = start.ToString(@"hh\:mm");

                                        <option value="@timeValue">@displayTime</option>

                                        start = start.Add(TimeSpan.FromMinutes(30));
                                    }
                                }
                            </select>
                            <span asp-validation-for="Time" class="text-danger small"></span>
                        </div>

                        
                        <div class="d-grid gap-2 pt-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">Submit Appointment</button>
                            <a asp-action="Create" class="btn btn-outline-secondary btn-lg rounded-pill fw-semibold">Cancel</a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}